# From `npx convex dev` — printed on first run, also in .env.local
CONVEX_URL=https://<your-deployment>.convex.cloud

# Convex Dashboard → Settings → Deploy keys → "Generate admin key"
# NOTE: this is an ADMIN credential. It bypasses Clerk auth entirely.
# See KILL-TEST.md §Caveats — tenant isolation is application code's job on this path.
CONVEX_ADMIN_KEY=

# Only needed for the OPTIONAL agent/tool-approval demo (src/optional-agent-demo.ts).
# The kill-test itself does NOT need a model key.
OPENAI_API_KEY=
