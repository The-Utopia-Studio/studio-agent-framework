{
  "schema_version": "1.0.0",
  "agent": { "id": "memory-workflow-agent", "name": "Memory workflow agent", "job": "Save a tenant-scoped note and resume a durable workflow to retrieve it later.", "owner": "Studio", "module": "examples", "non_goals": ["Share notes across tenants", "Execute autonomous external writes"] },
  "lifecycle": { "rung": 4, "runtime_home": "local test process", "talk_surface": "cli", "trigger": "human", "tool_identity": "agent service identity" },
  "security": {
    "data_profile": "fellow-scoped", "principal_source": "authenticated-fellow-context", "allowed_data_classes": ["public", "fellow-private"], "tool_allowlist": ["save_note"],
    "audit_log_check": { "id": "audit-log", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "Every workflow transition has an attributable local event trace.", "evidence_ref": "tests/conformance.mjs" },
    "undeclared_tool_check": { "id": "allowlist-only", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "The agent invokes only tools declared in its manifest.", "evidence_ref": "tests/conformance.mjs" },
    "out_of_scope_data_check": { "id": "tenant-boundary", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "Memory reads remain inside the authenticated tenant scope.", "evidence_ref": "tests/conformance.mjs" },
    "secret_output_check": { "id": "secret-redaction", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "No credential or secret appears in the memory response.", "evidence_ref": "tests/conformance.mjs" },
    "tenant_isolation_check": { "id": "tenant-isolation", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "A tenant cannot retrieve another tenant's stored note.", "evidence_ref": "tests/conformance.mjs" }
  },
  "runtime": { "harness": "mastra-convex", "packages": [ { "name": "@mastra/core", "version": "1.63.2" }, { "name": "@mastra/convex", "version": "1.5.4" } ], "workflow": { "required": true, "rationale": "The save and resume steps must retain state across a process restart.", "approval": false } },
  "tools": [ { "name": "save_note", "effect": "write", "identity": "agent service identity", "idempotency": "check-first" } ],
  "state": { "canonical_store": "Convex", "tenant_key": "tenant_id", "event_log": { "append_only": true, "external_read_check": { "id": "trace-read", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "The tenant-scoped workflow trace can be read after resume.", "evidence_ref": "tests/conformance.mjs" } }, "memory": { "channels": ["working"], "deterministic_write": true, "freshness_check": { "id": "memory-freshness", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "A successful save advances the durable memory record.", "evidence_ref": "tests/conformance.mjs" }, "write_behavior_check": { "id": "memory-write", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "The deterministic memory writer records the requested note.", "evidence_ref": "tests/conformance.mjs" } } },
  "operations": { "preflight": { "required": true, "dependencies": ["Convex store"], "record_check": { "id": "preflight-recorded", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "The agent records precondition_checked before workflow work.", "evidence_ref": "tests/adapter.mjs" } }, "health_statuses": ["ok", "degraded", "offline", "failed"], "budget": { "currency": "USD", "max_per_period": 1, "period": "run", "enforcement_check": { "id": "budget", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "A workflow run never exceeds its declared local budget.", "evidence_ref": "tests/conformance.mjs" } } },
  "evaluation": { "adapter_contract": "run(fixture, ctx) -> report", "output_eval": { "fixture_refs": ["tests/fixtures/save.json", "tests/fixtures/resume.json"], "check": { "id": "output-eval", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "The generated report matches every selected fixture expectation.", "evidence_ref": "tests/adapter.mjs" } }, "behavior_eval": { "enabled": true, "check": { "id": "behavior-compiler", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "The workflow emits a gradeable ordered event trace.", "evidence_ref": "tests/adapter.mjs" } } },
  "conformance": [ { "id": "journey", "status": "verified", "check": { "id": "journey", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "The generated agent completes its local journey tests.", "evidence_ref": "tests/conformance.mjs" } } ],
  "evidence": { "reproducibility": "internal-rerunnable", "references": ["tests/adapter.mjs", "tests/fixtures/resume.json"] }
}
