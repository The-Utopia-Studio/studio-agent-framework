{
  "schema_version": "1.0.0",
  "agent": { "id": "briefing-agent", "name": "Briefing agent", "job": "Turn a supplied topic into a short, clearly labeled briefing for a reader.", "owner": "Studio", "module": "examples", "non_goals": ["Persist information between runs", "Call external services"] },
  "lifecycle": { "rung": 4, "runtime_home": "local test process", "talk_surface": "cli", "trigger": "human", "tool_identity": "none" },
  "security": {
    "data_profile": "public", "principal_source": "anonymous-or-user-session", "allowed_data_classes": ["public"], "tool_allowlist": ["format_brief"],
    "audit_log_check": { "id": "audit-log", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "Every completed run has an attributable local event trace.", "evidence_ref": "tests/conformance.mjs" },
    "undeclared_tool_check": { "id": "allowlist-only", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "The agent invokes only tools declared in its manifest.", "evidence_ref": "tests/conformance.mjs" },
    "out_of_scope_data_check": { "id": "public-boundary", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "The agent reads only the public input supplied for the run.", "evidence_ref": "tests/conformance.mjs" },
    "secret_output_check": { "id": "secret-redaction", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "No credential or secret appears in the generated briefing.", "evidence_ref": "tests/conformance.mjs" }
  },
  "runtime": { "harness": "none", "packages": [], "workflow": { "required": false, "rationale": "A single deterministic transformation has no mid-flight state to resume.", "approval": false } },
  "tools": [ { "name": "format_brief", "effect": "read", "identity": "none", "idempotency": "not-needed" } ],
  "state": { "canonical_store": "none", "tenant_key": "public", "event_log": { "append_only": true, "external_read_check": { "id": "trace-read", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "The local run trace can be read after completion.", "evidence_ref": "tests/conformance.mjs" } }, "memory": { "channels": ["none"] } },
  "operations": { "preflight": { "required": true, "dependencies": ["fixture input"], "record_check": { "id": "preflight-recorded", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "The agent records precondition_checked before producing output.", "evidence_ref": "tests/adapter.mjs" } }, "health_statuses": ["ok", "degraded", "offline", "failed"], "budget": { "currency": "USD", "max_per_period": 1, "period": "run", "enforcement_check": { "id": "budget", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "A run never exceeds its declared local budget.", "evidence_ref": "tests/conformance.mjs" } } },
  "evaluation": { "adapter_contract": "run(fixture, ctx) -> report", "output_eval": { "fixture_refs": ["tests/fixtures/fresh.json", "tests/fixtures/refusal.json"], "check": { "id": "output-eval", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "The generated report matches every selected fixture expectation.", "evidence_ref": "tests/adapter.mjs" } }, "behavior_eval": { "enabled": true, "check": { "id": "behavior-compiler", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "The stateless run emits a gradeable ordered event trace.", "evidence_ref": "tests/adapter.mjs" } } },
  "conformance": [ { "id": "journey", "status": "verified", "check": { "id": "journey", "enforcement": "repository-ci", "command": "node tests/conformance.mjs", "failure_condition": "The generated agent completes its local journey tests.", "evidence_ref": "tests/conformance.mjs" } } ],
  "evidence": { "reproducibility": "internal-rerunnable", "references": ["tests/adapter.mjs", "tests/fixtures/fresh.json"] }
}
